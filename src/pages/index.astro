---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import { getCollection } from "astro:content";
import { base, u, fixHtml } from "../lib/url";

// Έργα: από src/content/projects/*.md, χωρίς τα draft, ταξινόμηση με "order".
const entries = (await getCollection("projects", (p) => !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const projects = entries.map((p) => ({
  id: p.id,
  ...p.data,
  cover: u(p.data.cover),
  gallery: p.data.gallery.map(u),
  model: p.data.model ? u(p.data.model) : "",
  facts: Object.fromEntries(p.data.facts.map((f) => [f.label, f.value])),
  // Η περιγραφή σε HTML, από το Markdown, την ώρα του build (περιεχόμενο από το repo).
  html: fixHtml(p.rendered?.html ?? ""),
}));
// Φίλτρα: οι κατηγορίες που έχουν τα έργα, με τη σειρά που εμφανίζονται.
const categories = [...new Set(projects.flatMap((p) => p.categories))];
// JSON μέσα σε <script>: το "<" γίνεται \u003c για να μην κλείσει το tag.
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const data = `window.BASE=${json(base)};window.SERVICES=${json(site.services)};window.STEPS=${json(site.steps)};window.CATEGORIES=${json(categories)};window.PROJECTS=${json(projects)};`;
---
<Base title="Αλέξανδρος Βλάχος | Πολιτικός μηχανικός, Λευκάδα" description="Τεχνικό γραφείο του πολιτικού μηχανικού Αλέξανδρου Βλάχου στη Λευκάδα. Άδειες, μελέτες, ενεργειακά, τοπογραφικά και κατασκευή κατοικιών.">
<Fragment slot="head">
<!-- 3D hero: fetch everything in parallel instead of one after another. -->
<link rel="modulepreload" href="https://unpkg.com/three@0.170.0/build/three.module.min.js">
<link rel="modulepreload" href={u("/model3d.js")}>
<link rel="preload" as="fetch" crossorigin="anonymous" href={u("/models/tsoukalades-villa.glb")}>
<link rel="preload" as="fetch" crossorigin="anonymous" href="https://unpkg.com/three@0.170.0/examples/jsm/libs/draco/gltf/draco_wasm_wrapper.js">
<link rel="preload" as="fetch" crossorigin="anonymous" href="https://unpkg.com/three@0.170.0/examples/jsm/libs/draco/gltf/draco_decoder.wasm">
</Fragment>

<main id="top">

<section class="hero">
  <canvas id="hero3d" aria-label="Τρισδιάστατο μοντέλο κατοικίας"></canvas>
  <div class="hero-shade"></div>
  <div class="hero-inner wrap">
    <p class="label">Μελέτες · Άδειες · Ενέργεια · Κατασκευή</p>
    <h1>Μελέτη, άδεια<br>και κατασκευή.</h1>
    <div class="hero-foot">
      <div class="cta">
        <a href="#contact" class="btn btn-primary">Κλείστε αυτοψία</a>
        <a href="#projects" class="btn btn-ghost">Δείτε έργα</a>
      </div>
    </div>
  </div>
</section>

<section id="projects" class="projects wrap">
  <header class="sec-head reveal">
    <h2>Επιλεγμένα έργα</h2>
  </header>
  <div class="filters" id="filters" role="group" aria-label="Φίλτρο κατηγορίας"></div>
  <div class="proj-grid" id="projectGrid"></div>
</section>

<section id="services" class="services wrap">
  <header class="sec-head reveal">
    <h2>Τι αναλαμβάνουμε</h2>
  </header>
  <ol class="svc-list" id="serviceList"></ol>
</section>

{site.process.show && (
<section id="process" class="process wrap">
  <header class="sec-head reveal">
    <h2>{site.process.title}</h2>
  </header>
  <ol class="steps" id="steps"></ol>
</section>
)}

<section id="contact" class="contact wrap reveal">
  <div>
    <h2>Πείτε μας για το ακίνητό σας.</h2>
    <p class="muted">Απαντάμε την ίδια ή την επόμενη εργάσιμη.</p>
    <dl class="contact-facts">
      <dt>Γραφείο</dt><dd>{site.contact.address}</dd>
      <dt>Τηλέφωνο</dt><dd><a href={`tel:${site.contact.phoneIntl}`}>{site.contact.phone}</a></dd>
      <dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
    </dl>
  </div>
  <form class="form" id="contactForm" data-key={site.contact.formKey ?? ""}>
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <label>Όνομα<input required name="name" autocomplete="name"></label>
    <label>Τηλέφωνο<input required name="phone" type="tel" autocomplete="tel"></label>
    <label>Τι χρειάζεστε;
      <select name="need">
        <option>Άδεια δόμησης / νέα κατοικία</option>
        <option>Ανακαίνιση</option>
        <option>Ενεργειακή αναβάθμιση / Εξοικονομώ</option>
        <option>Τακτοποίηση αυθαιρέτου</option>
        <option>Τοπογραφικό</option>
        <option>Κάτι άλλο</option>
      </select>
    </label>
    <label>Μήνυμα<textarea name="msg" rows="3"></textarea></label>
    <button class="btn btn-primary" type="submit">Αποστολή</button>
    <p class="ok label" role="status" aria-live="polite" hidden></p>
  </form>
  <script is:inline define:vars={{ phone: site.contact.phone }}>
    const form = document.getElementById("contactForm");
    const msg = form.querySelector(".ok");
    const say = (t) => { msg.textContent = t; msg.hidden = false; };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const key = form.dataset.key;
      if (!key) return say(`Η φόρμα δεν στέλνει ακόμα μηνύματα. Πάρτε μας στο ${phone}.`);
      const btn = form.querySelector("button");
      const data = Object.fromEntries(new FormData(form));
      btn.disabled = true;
      say("Αποστολή…");
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            ...data,
            access_key: key,
            botcheck: !!data.botcheck,
            subject: `Νέο μήνυμα από το site: ${data.need}`,
            from_name: "Site Αλέξανδρος Βλάχος",
          }),
        });
        const out = await res.json();
        if (!out.success) throw new Error(out.message);
        form.reset();
        say("Ευχαριστούμε! Λάβαμε το μήνυμά σας και θα σας καλέσουμε σύντομα.");
      } catch {
        say(`Το μήνυμα δεν στάλθηκε. Πάρτε μας στο ${phone}.`);
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</section>

</main>

<dialog id="projectDialog" class="dlg" aria-labelledby="dlgTitle">
  <button class="dlg-close" aria-label="Κλείσιμο" onclick="this.closest('dialog').close()">✕</button>
  <div id="dlgBody"></div>
</dialog>

<Fragment slot="scripts">
<script is:inline set:html={data}></script>
<script is:inline src={u("/carousel.js")}></script>
<script is:inline src={u("/app.js")}></script>
<script is:inline type="module" src={u("/hero3d.js")}></script>
</Fragment>
</Base>
