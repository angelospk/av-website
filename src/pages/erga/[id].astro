---
// Σελίδα έργου στα ελληνικά: /erga/<id>/ (για κοινοποίηση και Google). Περιεχόμενο: src/components/ProjectPage.astro.
import ProjectPage from "../../components/ProjectPage.astro";
import { getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  return (await getProjects("el")).map((p) => ({ params: { id: p.id }, props: { p } }));
}
---
<ProjectPage lang="el" p={Astro.props.p} />
